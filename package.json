{
  "name": "@editai/desktop",
  "productName": "EDIT AI",
  "version": "1.0.0-editai.2",
  "description": "Editor desktop de vídeo com IA para short-form, vendas e TikTok Shop",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:ffmpeg": "node scripts/build-ffmpeg.mjs",
    "build:ffmpeg:torchcodec": "node scripts/fetch-ffmpeg-source.mjs 7.1.5 ffmpeg-torchcodec && node scripts/build-ffmpeg-torchcodec.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg-source.mjs",
    "stage:node": "node scripts/stage-node.mjs",
    "stage:uv": "node scripts/stage-uv.mjs",
    "stage:yt-dlp": "node scripts/stage-yt-dlp.mjs",
    "stage:codex": "node scripts/stage-codex-app-server.mjs",
    "test:codex-protocol": "node scripts/smoke-codex-app-server.mjs",
    "test:timeline": "node scripts/test-timeline-model.mjs",
    "test:media": "node scripts/test-media-selection.mjs",
    "test:helpers": "node scripts/test-helpers.mjs",
    "test:jcut": "node scripts/test-jcut.mjs",
    "test:clean-cut": "node scripts/test-clean-cut.mjs",
    "test:animations": "node scripts/test-animations.mjs",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "test:fingerprint": "node scripts/test-fingerprint.mjs",
    "test:ai-catalog": "node scripts/test-ai-catalog.mjs",
    "test:codex-engine": "node scripts/test-codex-engine.mjs",
    "test:render-message": "node scripts/test-render-message.mjs",
    "test:split-layout": "node scripts/test-split-layout.mjs",
    "test:chat-language": "node scripts/test-chat-language.mjs",
    "test:member-auth": "node scripts/test-member-auth.mjs",
    "test:project-layout": "node scripts/test-project-layout.mjs",
    "test:project-files": "node scripts/test-project-files.mjs",
    "test:clean-cut-pipeline": "node scripts/test-clean-cut-pipeline.mjs",
    "test:clean-cut-live": "node scripts/test-clean-cut-live.mjs",
    "test:phase2-data": "node scripts/test-phase2-data.mjs",
    "test:music-brief": "node scripts/test-music-brief.mjs",
    "test:phase2-preview": "node scripts/test-phase2-preview.mjs",
    "test:generation-tier": "node scripts/test-generation-tier.mjs",
    "test:hub-generation": "node scripts/test-hub-generation.mjs",
    "test:edit-data-edits": "node scripts/test-edit-data-edits.mjs",
    "test:ffmpeg-alpha": "node scripts/test-ffmpeg-alpha.mjs",
    "test:graphic-layers": "node scripts/test-graphic-layers.mjs",
    "test:edit-plan": "node scripts/test-edit-plan.mjs",
    "test:virtual-cut": "node scripts/test-virtual-cut.mjs",
    "test:preview-proxy": "node scripts/test-preview-proxy.mjs",
    "test:work-queue": "node scripts/test-work-queue.mjs",
    "test:playback-speed": "node scripts/test-playback-speed.mjs",
    "test:style-layers": "node scripts/test-style-layers.mjs",
    "test:style-layer-integration": "node scripts/test-style-layer-integration.mjs",
    "test:editai-diagnostics": "node scripts/test-editai-diagnostics.mjs",
    "test:editai-commercial-evidence": "node scripts/test-editai-commercial-evidence.mjs",
    "spike:preparar": "node spike/prepare.mjs",
    "spike": "vite --config spike/live-preview/vite.config.ts",
    "spike:quebrado": "EDVID_SPIKE_GRAFICOS=template vite --config spike/live-preview/vite.config.ts --port 4833",
    "stage:python-whisperx": "node scripts/stage-python-whisperx.mjs",
    "prepare:forge-makers": "node scripts/prepare-forge-makers.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run stage:node && npm run stage:uv && npm run stage:yt-dlp && npm run stage:codex && npm run build:ffmpeg && npm run build:ffmpeg:torchcodec && npm run stage:python-whisperx && npx --yes --package=node@22.23.2 -c \"electron-forge package\"",
    "make": "npm run stage:node && npm run stage:uv && npm run stage:yt-dlp && npm run stage:codex && npm run build:ffmpeg && npm run build:ffmpeg:torchcodec && npm run stage:python-whisperx && npm run prepare:forge-makers && npx --yes --package=node@22.23.2 -c \"electron-forge make\"",
    "pack:runtimes": "node scripts/pack-runtimes.mjs",
    "verify:editai": "npm run typecheck && npm run test:timeline && npm run test:media && npm run test:helpers && npm run test:clean-cut && npm run test:clean-cut-pipeline && npm run test:jcut && npm run test:virtual-cut && npm run test:preview-proxy && npm run test:work-queue && npm run test:playback-speed && npm run test:style-layers && npm run test:style-layer-integration && npm run test:split-layout && npm run test:editai-diagnostics && npm run test:phase2-data && npm run test:edit-data-edits && npm run test:editai-commercial-evidence && node scripts/verify-editai-release.mjs",
    "verify:editai:release": "node scripts/verify-editai-release.mjs --release",
    "configure:editai:release": "node scripts/configure-editai-release.mjs",
    "publish:editai:runtimes": "node scripts/editai-publish-runtimes.mjs",
    "publish:editai:update": "node scripts/editai-publish-update.mjs",
    "build:editai:win:qa": "powershell -ExecutionPolicy Bypass -File scripts/editai-build-windows.ps1 -Mode qa",
    "build:editai:win:release": "powershell -ExecutionPolicy Bypass -File scripts/editai-build-windows.ps1 -Mode release",
    "inspect:editai:win": "powershell -ExecutionPolicy Bypass -File scripts/editai-inspect-windows-artifacts.ps1",
    "smoke:editai:win": "powershell -ExecutionPolicy Bypass -File scripts/editai-smoke-windows.ps1",
    "smoke:editai:install": "powershell -ExecutionPolicy Bypass -File scripts/editai-install-smoke-windows.ps1",
    "smoke:editai:media": "powershell -ExecutionPolicy Bypass -File scripts/editai-media-smoke-windows.ps1",
    "smoke:editai:e2e": "powershell -ExecutionPolicy Bypass -File scripts/editai-e2e-real-video-windows.ps1",
    "package:editai:standalone:win": "powershell -ExecutionPolicy Bypass -File scripts/editai-package-standalone-windows.ps1"
  },
  "author": "EDIT AI",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/lib-storage": "^3.1112.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@remotion/layout-utils": "^4.0.482",
    "@remotion/player": "^4.0.482",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "43.4.0",
    "remotion": "^4.0.482",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}